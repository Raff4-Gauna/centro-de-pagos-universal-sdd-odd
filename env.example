# Platform environment of the Hub (T-PLT-39, RN-PLT-03, RF-PLT-04, design.md sec. 3.2.2).
#
#   copy env.example .env        (from the repo root; cp on bash)
#   docker compose -f infra/docker-compose.yml --env-file .env up -d --build --wait
#
# .env is ignored by git and never committed. Every value below is a fictitious, low-entropy
# development value: never a real credential, and never the production ones (C-06).
# Platform only: the provider keys of the spikes live apart, in spikes/env.example (RN-PLT-04,
# Q-048), and no Hub setting reads them. Even if one is left in .env, Compose passes a container
# only the variables listed under `environment:` (D-04).
#
# Parity: backend/tests/config/test_AC_PLT_05_env_example_parity.py fails naming any variable the
# platform reads that is missing here, and any variable here that nothing reads. A task that adds
# a variable to backend/config/settings/env.py adds it here in the same commit.
# An empty value counts as unset: the default of config/settings/env.py applies.

# --- Django (backend, worker, beat) ---
# Any long value works in dev; prod requires >= 50 characters and rejects "django-insecure".
DJANGO_SECRET_KEY=dev-only-not-a-secret-dev-only-not-a-secret-dev-only-not-a-secret
# The dev Compose fixes it to true (it does not read this line); empty means false elsewhere.
DJANGO_DEBUG=
# Must keep localhost (the backend healthcheck calls http://localhost:8000/readyz) and backend
# (the BFF of the frontend Compose service calls http://backend:8000; without it Django answers
# 400 DisallowedHost). Left empty, the default (localhost,127.0.0.1) lacks backend.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# <requests>/<s|min|h|day>; generous on purpose (RN-PLT-19).
API_THROTTLE_ANON_RATE=300/min
# Proxies in front of the backend that append to X-Forwarded-For; 0 until the hosting (Q-020).
TRUSTED_PROXY_COUNT=0

# --- Identity: the Hub's access JWT (SPEC-01, ADR-0004 sec. 5) ---
# Empty keys: the Hub starts, but it neither issues nor verifies a token. Never commit a key.
# The signing key is a P-256 PEM (double-quoted, with its line breaks, in .env):
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Its public half (`openssl ec -pubout`) goes in the JSON object {"<kid>": "<public PEM>"}, which
# during a rotation also holds the previous key (specs/01-identity-access/design.md sec. 10).
IDENTITY_JWT_ISSUER=centro-de-pagos
IDENTITY_JWT_AUDIENCE=centro-de-pagos-api
IDENTITY_JWT_SIGNING_KID=
IDENTITY_JWT_SIGNING_KEY=
IDENTITY_JWT_VERIFICATION_KEYS=

# --- Database (PostgreSQL) ---
# POSTGRES_* initialise the db service (only on an empty volume: see infra/README.md to recreate).
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub
POSTGRES_DB=hub
# Host db (the Compose service) and the same data as POSTGRES_*; special characters go
# percent-encoded.
DATABASE_URL=postgres://hub:hub@db:5432/hub

# --- Redis (Celery broker and cache) ---
REDIS_URL=redis://redis:6379/0

# --- Frontend, server side only (BFF; never a NEXT_PUBLIC_ variable, Q-050) ---
# Internal backend URL for `pnpm dev` on the host; the frontend Compose service sets its own
# http://backend:8000 (design.md sec. 3.4.1).
BACKEND_INTERNAL_URL=http://localhost:8000

# --- Observability ---
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
APP_VERSION=dev

# --- Feature flags (RF-PLT-19) ---
# FEATURE_<NAME>=true|false, off when unset. Only names registered in
# backend/apps/common/feature_flags.py REGISTRY (empty in SPEC-00): an unregistered FEATURE_*
# variable stops the start. Example, commented on purpose:
# FEATURE_EXAMPLE_NAME=false
